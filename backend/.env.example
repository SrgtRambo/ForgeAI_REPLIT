# ---- Required ----
# Use the Forge AI Supabase project. Run sql/schema.sql only for optional purchase/payment routes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only key. Never put this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- Payments (optional until you are ready to charge) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Optional ----
PORT=3001
# Public URL of this server (used for Stripe redirects).
BASE_URL=http://localhost:3001
# Where Stripe sends customers back to (your Forge AI site). Defaults to BASE_URL.
FRONTEND_URL=
# Comma-separated list of sites allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:8080
# OpenRouter model per tier (any model id from openrouter.ai/models).
MODEL_STANDARD=google/gemini-2.5-flash
MODEL_PRO=anthropic/claude-sonnet-4.5

# Forge AI website pipeline models (verify slugs at openrouter.ai/models before use).
MODEL_ANALYSIS=
MODEL_COPY=
MODEL_CRITIC=
ALLOW_SITE_GENERATION=false
SITE_PER_USER_PER_MINUTE=1
SITE_PER_USER_PER_DAY=3
SITE_PER_IP_PER_DAY=50
SITE_GLOBAL_PER_DAY=20
MAX_QUEUED_JOBS=10

# Free analysis limit per user per day.
ANALYSIS_DAILY_LIMIT=5

# Stock imagery (Unsplash first, Pexels second).
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Storage bucket for finished zips (private bucket).
STORAGE_BUCKET=projects
# How many generation jobs run at the same time.
JOB_CONCURRENCY=2
# Set to true ONLY while testing without Stripe: signed-in users can generate for free.
ALLOW_FREE_GENERATION=false
